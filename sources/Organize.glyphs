@CombCase = [acutecomb.case brevecomb.case brevecomb_acutecomb.case brevecomb_gravecomb.case brevecomb_hookabovecomb.case brevecomb_tildecomb.case breveinvertedcomb.case caroncomb.case cedillacomb.case circumflexcomb.case circumflexcomb_acutecomb.case circumflexcomb_gravecomb.case circumflexcomb_hookabovecomb.case circumflexcomb_tildecomb.case commaaccentcomb.case dblgravecomb.case dieresiscomb.case dotaccentcomb.case dotbelowcomb.case gravecomb.case hookabovecomb.case horncomb.case hungarumlautcomb.case macroncomb.case ogonekcomb.case ringcomb.case tildecomb.case];
@CombTop = [acutecomb brevecomb brevecomb_acutecomb brevecomb_gravecomb brevecomb_hookabovecomb brevecomb_tildecomb breveinvertedcomb caroncomb circumflexcomb circumflexcomb_acutecomb circumflexcomb_gravecomb circumflexcomb_hookabovecomb circumflexcomb_tildecomb dblgravecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb];
@CombBelow = [brevebelowcomb cedillacomb commaaccentcomb dieresisbelowcomb dotbelowcomb macronbelowcomb ogonekcomb];

lookup ccmp_soft_dotted {
    sub [i j iogonek idotbelow]' @CombTop by [idotless jdotless iogonek.dotless idotbelow.dotless];
    sub [i j iogonek idotbelow]' [@CombBelow horncomb] @CombTop by [idotless jdotless iogonek.dotless idotbelow.dotless];
} ccmp_soft_dotted;

lookup ccmp_case_marks {
    sub @Uppercase @CombNoCase' by @CombCase;
    sub @Uppercase @CombCase @CombNoCase' by @CombCase;
} ccmp_case_marks;
";
tag = ccmp;
},
{
code = "script latn;
    language CAT exclude_dflt;
        lookup LDOT {
            sub L' periodcentered' L by Ldot;
            sub l' periodcentered' l by ldot;
        } LDOT;
    language NLD exclude_dflt;
        lookup IJ {
            sub I' J' by IJ;
            sub i' j' by ij;
            sub Iacute J' by Jacute.loclNLD;
            sub iacute j' by jacute.loclNLD;
        } IJ;
    language ROM exclude_dflt;
        lookup ROM_COMMA {
            sub Scedilla by Scommaaccent;
            sub Tcedilla by Tcommaaccent;
            sub scedilla by scommaaccent;
            sub tcedilla by tcommaaccent;
        } ROM_COMMA;
    language MOL exclude_dflt;
        lookup ROM_COMMA;";
tag = locl;
},
